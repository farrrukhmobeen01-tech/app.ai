        "courseId": { "type": "string" },
        "ownerId": { "type": "string" },
        "memberIds": { "type": "array", "items": { "type": "string" } },
        "memberEmails": { "type": "array", "items": { "type": "string" } },
        "deadline": { "type": "string" },
        "createdAt": { "type": "string" }
